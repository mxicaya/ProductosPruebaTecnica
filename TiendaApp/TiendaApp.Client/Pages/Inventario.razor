@page "/inventario"
@using TiendaApp.Client.Models
@inject HttpClient Http
@rendermode InteractiveWebAssembly

<PageTitle>Inventario | Gestión</PageTitle>

<style>
    /* Efecto cebra celeste opaco */
    .table-striped-celeste tbody tr:nth-of-type(odd) {
        background-color: #f1f8ff;
    }

    .table-striped-celeste tbody tr:nth-of-type(even) {
        background-color: #ffffff;
    }

    /* Placeholders en gris oscuro */
    .form-control::placeholder {
        color: #555555 !important;
        opacity: 1;
    }

    /* Estilo del título principal */
    .header-title {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: 800;
        color: #007bff;
        font-size: 2.2rem;
    }
</style>

<div class="container-fluid mt-3 px-4">

    @* --- ENCABEZADO --- *@
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-cart3 text-primary me-3" style="font-size: 3rem;"></i>
        <div>
            <h1 class="header-title mb-0">Sistema de Inventario</h1>
            <p class="text-muted small mb-0">Gestión de productos y stock</p>
        </div>
    </div>

    @if (productos == null)
    {
        <div class="text-center my-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        @* --- FORMULARIO DE AGREGAR / ACTUALIZAR --- *@
        <div class="mb-5 p-3 border rounded bg-white shadow-sm">
            <h5 class="text-primary fw-bold mb-4">
                <i class="bi bi-plus-lg me-1"></i> @(editandoId == null ? "AGREGAR NUEVO PRODUCTO" : "MODIFICAR PRODUCTO")
            </h5>
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold small">Código</label>
                    <input @bind="nuevo.Codigo" class="form-control border-secondary-subtle" placeholder="Ej: P001" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Nombre</label>
                    <input @bind="nuevo.Nombre" class="form-control border-secondary-subtle" placeholder="Ej: Pala o Piocha" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small">Precio</label>
                    <input @bind="nuevo.Precio" type="number" step="0.01" class="form-control border-secondary-subtle" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small">Stock</label>
                    <input @bind="nuevo.Stock" type="number" class="form-control border-secondary-subtle" />
                </div>
                <div class="col-md-3">
                    @if (editandoId == null)
                    {
                        <button @onclick="GuardarProducto" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
                            <i class="bi bi-save2-fill me-2"></i> Guardar Producto
                        </button>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <button @onclick="ActualizarProducto" class="btn btn-success w-100 fw-bold py-2 shadow-sm text-white">
                                <i class="bi bi-check-circle-fill me-2"></i> Actualizar
                            </button>
                            <button @onclick="CancelarEdicion" class="btn btn-secondary py-2 text-white">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* --- FILTRO DE BÚSQUEDA --- *@
        <div class="row mb-4">
            <div class="col-md-5">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0"
                           placeholder="Filtrar por nombre o código..."
                           @bind="textoFiltro" @bind:event="oninput" />
                </div>
            </div>
        </div>

        @* --- TABLA DE PRODUCTOS --- *@
        <div class="table-responsive rounded shadow-sm border">
            <table class="table table-striped-celeste align-middle mb-0">
                <thead class="bg-light">
                    <tr class="text-muted small">
                        <th class="ps-4">ID</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in ObtenerProductosFiltrados())
                    {
                        <tr>
                            <td class="ps-4 text-muted">@p.Id</td>
                            <td class="fw-bold text-secondary">@p.Codigo</td>
                            <td class="text-dark">@p.Nombre</td>
                            <td class="fw-normal">Q @p.Precio.ToString("N2")</td>
                            <td>
                                <span class="badge bg-primary rounded px-3 py-2 fw-bold" style="min-width: 50px;">
                                    @p.Stock
                                </span>
                            </td>
                            <td class="text-center pe-4">
                                @* BOTONES SEPARADOS Y CON COLORES SOLICITADOS *@
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-success btn-sm px-3 text-white shadow-sm" @onclick="() => PrepararEdicion(p)">
                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                    </button>
                                    <button class="btn btn-danger btn-sm px-3 text-white shadow-sm" @onclick="() => EliminarProducto(p.Id)">
                                        <i class="bi bi-trash3-fill me-1"></i> Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Producto>? productos;
    private Producto nuevo = new();
    private string textoFiltro = "";
    private int? editandoId = null;

    protected override async Task OnInitializedAsync() => await CargarProductos();

    private async Task CargarProductos()
    {
        var respuesta = await Http.GetFromJsonAsync<List<Producto>>("api/productos");
        productos = respuesta?.Where(p => p.Activo).ToList();
    }

    private IEnumerable<Producto> ObtenerProductosFiltrados()
    {
        if (productos == null) return new List<Producto>();
        if (string.IsNullOrWhiteSpace(textoFiltro)) return productos;

        return productos.Where(p =>
            p.Nombre.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
            p.Codigo.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase));
    }

    private async Task GuardarProducto()
    {
        if (!string.IsNullOrEmpty(nuevo.Nombre) && !string.IsNullOrEmpty(nuevo.Codigo))
        {
            await Http.PostAsJsonAsync("api/productos", nuevo);
            nuevo = new Producto();
            await CargarProductos();
        }
    }

    private void PrepararEdicion(Producto p)
    {
        editandoId = p.Id;
        nuevo = new Producto
            {
                Id = p.Id,
                Codigo = p.Codigo,
                Nombre = p.Nombre,
                Precio = p.Precio,
                Stock = p.Stock,
                Activo = true
            };
    }

    private async Task ActualizarProducto()
    {
        await Http.PutAsJsonAsync($"api/productos/{editandoId}", nuevo);
        await CancelarEdicion();
        await CargarProductos();
    }

    private async Task CancelarEdicion()
    {
        nuevo = new Producto();
        editandoId = null;
        await Task.CompletedTask;
    }

    private async Task EliminarProducto(int id)
    {
        var response = await Http.DeleteAsync($"api/productos/{id}");
        if (response.IsSuccessStatusCode)
        {
            await CargarProductos();
        }
    }
}